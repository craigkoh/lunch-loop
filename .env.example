# Public Supabase URL and publishable/anon key from `supabase status` (local) or your project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# Server only. Enable Places API (New) and restrict this key to your dev/prod domains.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Optional transactional email. Keep this server-only. Until RESEND_API_KEY is
# configured, owners can still copy and text one-time invitation links/codes.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Lunch Loop <invites@lunchloop.app>
RESEND_REPLY_TO=feedback@lunchloop.app
ADMIN_NOTIFICATION_EMAIL=craig@lunchloop.app
