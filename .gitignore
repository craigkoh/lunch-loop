# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Local AI-assistant instructions. They are regenerated or machine-specific,
# not part of the Lunch Loop application.
/AGENTS.md
/CLAUDE.md

# Supabase CLI generates local containers, credentials, and linked-project
# metadata here. These are regenerated as needed and must never be committed.
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
